<?xml version="1.0" encoding="UTF-8"?>
<!-- GENERATED by tools/build-agenda.mjs from data/agenda.statechart.json. Do not edit by hand. -->
<!-- «contract» context: every transition. foundational contract: bounded, attributable, traceable, correctable; assume · guarantee · evidence. -->
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="agenda.statechart" initial="human">
  <datamodel>
    <data id="tries" expr="0"/>
    <data id="k" expr="2"/>
    <data id="screenClean" expr="false"/><!-- set by the environment: screen clean -->
  </datamodel>
  <state id="human">
    <onentry><log label="decide"/><assign location="tries" expr="0"/></onentry>
    <transition event="delegate" cond="_event.data.concernsModeled" target="ai"><!-- ① Delegate: delegate [concerns modeled] / model; specify; compose; verify --><log label="model"/><log label="specify"/><log label="compose"/><log label="verify"/></transition>
  </state>
  <state id="ai">
    <onentry><log label="plan"/><log label="hand off"/><log label="act"/></onentry>
    <transition event="report" cond="_event.data.contractHolds" target="human"><!-- ② Report: report [contract holds] / trace; record; slice; explain --><log label="trace"/><log label="record"/><log label="slice"/><log label="explain"/></transition>
    <transition event="report" cond="!_event.data.contractHolds" target="quarantine"><!-- ③ Contain: report [contract violated] / withdraw closure; tries++ --><log label="withdraw closure"/><assign location="tries" expr="tries + 1"/></transition>
  </state>
  <state id="quarantine">
    <!-- state invariant: nothing exposed in use -->
    <onentry><log label="suspend everywhere"/></onentry>
    <transition cond="screenClean &amp;&amp; tries &lt; k" target="ai"><!-- ④ Re-admit: [screen clean ∧ tries &lt; k] / re-admit --><log label="re-admit"/></transition>
    <transition target="human"><!-- ⑤ Escalate: [else] / explain affected set --><log label="explain affected set"/></transition>
  </state>
</scxml>
