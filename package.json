{
  "name": "majidbabaei-personal-site",
  "private": true,
  "description": "Static personal academic website; Markdown news rendered at build time.",
  "scripts": {
    "build:news": "node tools/build-news.mjs",
    "check:news": "node tools/build-news.mjs --check",
    "test": "node --test tools/news.test.mjs tools/calendar.test.mjs",
    "check:calendar": "node tools/build-calendar.mjs --check",
    "build:calendar": "node tools/build-calendar.mjs",
    "check:projects": "node tools/build-projects.mjs --check",
    "build:projects": "node tools/build-projects.mjs",
    "build:public": "node tools/build-public.mjs && node tools/check-public.mjs"
  },
  "dependencies": {
    "marked": "18.2.0",
    "sanitize-html": "2.18.1"
  }
}
